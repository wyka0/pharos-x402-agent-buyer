# =============================================================================
# Pharos x402 Agent Buyer - environment configuration
# Copy to `.env.local` and adjust. NEVER commit `.env.local`.
# =============================================================================

# --- Pharos network (Atlantic Testnet) --------------------------------------
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com
PHAROS_CHAIN_ID=688689
PHAROS_NETWORK_ID=eip155:688689
PHAROS_EXPLORER_URL=https://atlantic.pharosscan.xyz

# --- Official Atlantic USDC (Pharos Token Registry; EIP-3009 capable) --------
PHAROS_USDC_ADDRESS=0xcfC8330f4BCAB529c625D12781b1C19466A9Fc8B
USDC_DECIMALS=6

# --- x402 resource server (seller side) --------------------------------------
# Receiving address for all paywalled endpoint settlements.
PAY_TO_ADDRESS=0xB0f7681668f916eEd97dA066D31aA295D34727c0

# --- Buyer agent wallet -------------------------------------------------------
# Dedicated burnable TESTNET wallet. The buyer agent signs + broadcasts USDC
# EIP-3009 transferWithAuthorizations from this key. Never expose to the client.
TEST_USER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# --- Optional -----------------------------------------------------------------
# Base URL of a running instance for scripts/verify-onchain.ts when you do not
# want the script to spawn its own `next start` (defaults to http://127.0.0.1:4319).
# APP_BASE_URL=http://127.0.0.1:3000
# Optional external facilitator adapter (verify/settle). Empty = self-settlement.
# X402_FACILITATOR_URL=
# Persist settled receipts across server restarts: memory (default) | file
# X402_RECEIPT_STORE=memory
